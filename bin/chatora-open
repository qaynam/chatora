#!/bin/sh
# Hands one URL to the Neovim that is already running chatora, or to the browser.
#
# Installed as the system's URL handler by `chatora-url-handler install`, which means every
# link the reader clicks arrives here — so anything that is not a Cosense page, and any
# failure at all, falls through to the browser they used before. A link that opens nothing is
# worse than a link that opens the wrong window.
set -eu

url=${1:-}
[ -n "$url" ] || exit 0

data_dir=${CHATORA_URL_HANDLER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/chatora/url-handler}
# AppleScript's `do shell script` runs with a minimal PATH, so the tools are resolved at
# install time and recorded here rather than looked up now.
[ -f "$data_dir/env" ] && . "$data_dir/env"
NVIM=${NVIM:-nvim}
TMUX_BIN=${TMUX_BIN:-tmux}

fallback=$(cat "$data_dir/fallback" 2>/dev/null || echo 'com.apple.Safari')
origins=$(cat "$data_dir/origins" 2>/dev/null || echo 'scrapbox.io')

browser() {
  open -b "$fallback" "$url" 2>/dev/null || open "$url"
  exit 0
}

host=$(printf '%s' "$url" | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://([^/?#]+).*#\1#')
match=no
for origin in $origins; do
  [ "$host" = "$origin" ] && match=yes
done
[ "$match" = yes ] || browser

# Several Neovims may be running; the first one that has chatora loaded gets the page.
for sock in "${TMPDIR:-/tmp}"/nvim."$(id -un)"/*/nvim.*.0; do
  [ -S "$sock" ] || continue
  [ "$("$NVIM" --server "$sock" --remote-expr 'exists(":Chatora")' 2>/dev/null)" = "2" ] || continue

  "$NVIM" --server "$sock" --remote-send "<C-\\><C-N>:Chatora open $url<CR>" 2>/dev/null || browser

  # Deliver the reader as well as the page. Neovim knows which pane holds it and which
  # terminal drew it, which beats guessing from the process tree.
  pane=$("$NVIM" --server "$sock" --remote-expr 'getenv("TMUX_PANE")' 2>/dev/null || true)
  case $pane in
    %*)
      "$TMUX_BIN" select-window -t "$pane" 2>/dev/null || true
      "$TMUX_BIN" switch-client -t "$pane" 2>/dev/null || true
      ;;
  esac
  term=$("$NVIM" --server "$sock" --remote-expr 'getenv("TERM_PROGRAM")' 2>/dev/null || true)
  case $term in
    '' | v:null) ;;
    *) open -a "$term" 2>/dev/null || true ;;
  esac
  exit 0
done

# Nothing is running chatora. Which terminal to open one in is a guess, and guessing wrong
# leaves the reader with nothing.
browser
